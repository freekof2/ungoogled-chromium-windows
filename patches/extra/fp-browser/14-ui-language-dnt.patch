# Fingerprint browser: UI locale and Do Not Track mode completion.
#
# UI language is applied before Chrome's resource bundle is initialized, while
# Do Not Track is applied to renderer preferences so both navigator.doNotTrack
# and the DNT request header use the same profile setting.

--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -12,2 +12,3 @@
 #include "base/base_paths.h"
+#include "base/fp_config/fp_config.h"
 #include "base/check.h"
@@ -1062,2 +1062,13 @@
  const base::CommandLine& command_line =
      *base::CommandLine::ForCurrentProcess();
+
+  if (!command_line.HasSwitch(switches::kProcessType) &&
+      !command_line.HasSwitch(switches::kLang) &&
+      fp_config::ModeAllowsOverride("ui_language.mode")) {
+    if (std::optional<std::string> ui_language =
+            fp_config::GetString("ui_language.value");
+        ui_language && !ui_language->empty()) {
+      base::CommandLine::ForCurrentProcess()->AppendSwitchASCII(
+          switches::kLang, *ui_language);
+    }
+  }
--- a/chrome/browser/renderer_preferences_util.cc
+++ b/chrome/browser/renderer_preferences_util.cc
@@ -150,5 +150,11 @@
   prefs->enable_referrers = pref_service->GetBoolean(prefs::kEnableReferrers);
   prefs->enable_do_not_track =
       pref_service->GetBoolean(prefs::kEnableDoNotTrack);
+  if (fp_config::ModeIsAny("do_not_track", {"enabled", "on"})) {
+    prefs->enable_do_not_track = true;
+  } else if (fp_config::ModeIsAny("do_not_track",
+                                  {"disabled", "off", "default"})) {
+    prefs->enable_do_not_track = false;
+  }
   prefs->enable_encrypted_media =
       pref_service->GetBoolean(prefs::kEnableEncryptedMedia);
