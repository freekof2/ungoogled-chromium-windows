+bool IsFontAllowed(const std::u16string& font_name) {
+  std::vector<std::string> configured_fonts =
+      fp_config::ModeAllowsOverride("fonts.mode")
+          ? fp_config::GetStringList("fonts.list")
+          : std::vector<std::string>();
+  if (configured_fonts.empty()) {
+    return true;
+  }
+  const std::string utf8_font = base::UTF16ToUTF8(font_name);
+  return std::any_of(configured_fonts.begin(), configured_fonts.end(),
+                     [&utf8_font](const std::string& configured_font) {
+                       return base::EqualsCaseInsensitiveASCII(configured_font,
+                                                               utf8_font);
+                     });
+}
 
