+TimeZone::TimeZone() {
+  std::unique_ptr<icu::TimeZone> zone;
+  if (std::optional<std::string> timezone =
+          fp_config::GetString("timezone.value");
+      fp_config::ModeAllowsOverride("timezone.mode") && timezone) {
+    zone = base::WrapUnique(icu::TimeZone::createTimeZone(
+        icu::UnicodeString::fromUTF8(*timezone)));
+  } else {
+    zone = base::WrapUnique(icu::TimeZone::createDefault());
+  }
+  impl_ = std::make_unique<Impl>(std::move(zone));
